{
	auto_https disable_redirects
	admin off
}

localhost:8443 {
	tls internal
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:8080
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}